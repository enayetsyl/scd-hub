# Copy to .env — never commit .env
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/scd-hub?retryWrites=true&w=majority
JWT_SECRET=change-me-in-production
PORT=4000
NODE_ENV=development
# School timezone (Asia/Dhaka)
TZ=Asia/Dhaka

# --- Google Drive live file store (GP-A, D-#70) -----------------------------
# OAuth refresh token on the SCHOOL's Google account (not a service account).
# Setup steps (no secrets) live in server/README.md. Without these, homework
# file attach/view fails with a Bangla notice; everything else works.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional: pin the root folder by id (else "SCD-Hub-Files" is found/created)
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Attendance reminder trigger (AT-4, D-#65) ------------------------------
# Shared secret the external scheduler sends in the `x-trigger-secret` header on
# POST /triggers/attendance-reminder. FAIL-CLOSED: if unset, the endpoint is
# disabled (every call 401s). See server/README.md for the cron lines.
ATTENDANCE_TRIGGER_SECRET=

# --- Monthly report: the guardian-comment model (MR-4, D-#399) ---
# OPTIONAL. With no key the comment falls back to the MessageTemplate paragraph
# (monthly_report.comment.fallback) — the report still builds and is still
# releasable, so an unset key is a degraded mode, never an outage.
# Google AI Studio key for the Generative Language API. The prompt is
# DE-IDENTIFIED before it leaves the server (no name, school id or phone), so no
# identity reaches the provider on any tier.
GEMINI_API_KEY=
# Optional model override; defaults to gemini-2.5-flash.
GEMINI_MODEL=

# --- English Drive block splitter (ED-5, D-#455) ----------------------------
# OPTIONAL. The split itself is DETERMINISTIC — the sheets are cut from the block
# file's own headings — so with no key every sheet is still produced; the upload
# screen just labels them "কেটে আলাদা করা" and lists why. The model only writes
# the teacher sheet's front matter and tidies formatting, and any tidy that
# changes a sheet's numbered items is discarded.
# OpenRouter key (https://openrouter.ai/keys). Only curriculum markdown goes out —
# no student, guardian or staff record has a path here.
OPENROUTER_API_KEY=
# Optional model override; defaults to deepseek/deepseek-v4-flash (~$0.14/M in —
# a block split is a fraction of a paisa). Checked 2026-08-05: OpenRouter lists no
# `:free` DeepSeek variant. For a zero-cost deployment use a free id instead, e.g.
# google/gemma-4-31b-it:free or openai/gpt-oss-20b:free (rate-limited).
OPENROUTER_MODEL=
# Optional base-URL override (an OpenAI-compatible gateway or a test double).
OPENROUTER_BASE_URL=

# --- Observability / error tracking (MON-2/3, prd-observability.md, D-#252/#253) ---
# Self-hosted GlitchTip (https://scdhub-errors.shafayet.me). All OPTIONAL — every SDK
# is a no-op when its DSN is unset, so local dev is unaffected.
# Server (@sentry/node): the scdhub-server project DSN + per-env tag + build sha.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
GIT_SHA=
# Set to 1 on a NON-production service to expose GET /debug/sentry (MON-2 verification).
SENTRY_DEBUG_ROUTE=
# App (@sentry/react-native): the scdhub-app project DSN. A DSN is a write-only ingest
# key — safe to bundle (like the other EXPO_PUBLIC_* values).
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ENV=development
# CI/EAS build secret for source-map/symbol upload (deploy.sh). NEVER EXPO_PUBLIC, never bundled.
SENTRY_AUTH_TOKEN=
