{
  "expo": {
    "name": "SCD Hub",
    "slug": "scd-hub",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/ef69db4d-e518-4334-955f-d0abf69ec8d9",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scd.hub"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.scd.hub",
      "versionCode": 2,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "url": "https://errors.scdhub.shafayet.me",
          "organization": "scd",
          "project": "scdhub-app"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ef69db4d-e518-4334-955f-d0abf69ec8d9"
      }
    },
    "owner": "rahman365"
  }
}
