        { "key": "s5-6", "text": "Where does a cow live?", "answer": "A cow lives in a shed or a cowshed.", "marks": 1, "source": "MP_OTHER", "sourceRef": "মোহাম্মদপুর বার্ষিক ২০২৫ · প্রশ্ন ৬(গ)", "bookRef": "Unit 9, p.85", "needsPicture": false, "note": null },
        { "key": "s5-7", "text": "What does a cow give us?", "answer": "A cow gives us milk.", "marks": 1, "source": "NEW", "sourceRef": null, "bookRef": "Unit 9, p.89", "needsPicture": false, "note": null },
        { "key": "s5-8", "text": "What does a tiger eat?", "answer": "A tiger eats meat.", "marks": 1, "source": "NEW", "sourceRef": null, "bookRef": "Unit 9, p.87", "needsPicture": false, "note": null },
        { "key": "s5-9", "text": "What does Mita's mother do?", "answer": "She is a health worker.", "marks": 1, "source": "NEW", "sourceRef": null, "bookRef": "Unit 8, p.77–78", "needsPicture": false, "note": null },
