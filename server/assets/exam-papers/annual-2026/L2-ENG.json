        { "key": "s5-2", "text": "What does the yellow light mean?", "answer": "The yellow light means wait.", "marks": 1, "source": "MP2026_ADAPTED", "sourceRef": "মোহাম্মদপুর বার্ষিক ২০২৬ · প্রশ্ন ৫(ক)", "bookRef": "Unit 7, p.72–73", "needsPicture": false, "note": "৩ নম্বরের প্রশ্ন ভাগ করা হয়েছে" },
        { "key": "s5-3", "text": "What does the green light mean?", "answer": "The green light means go.", "marks": 1, "source": "MP2026_ADAPTED", "sourceRef": "মোহাম্মদপুর বার্ষিক ২০২৬ · প্রশ্ন ৫(ক)", "bookRef": "Unit 7, p.72–73", "needsPicture": false, "note": "৩ নম্বরের প্রশ্ন ভাগ করা হয়েছে" },
