        { "key": "s2-2", "text": "The boys begin to ________ the stones at the frogs.", "answer": "throw", "marks": 1, "source": "MP2026", "sourceRef": "মোহাম্মদপুর বার্ষিক ২০২৬ · প্রশ্ন ১", "bookRef": "Unit 10, p.96", "needsPicture": false, "note": null },
