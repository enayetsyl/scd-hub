      "items": [
        { "key": "s4-1", "text": "What are the frogs doing?", "answer": "Some frogs are playing in the water.", "marks": 1, "source": "MP2026", "sourceRef": "মোহাম্মদপুর বার্ষিক ২০২৬ · প্রশ্ন ৩", "bookRef": "Unit 10, p.96", "needsPicture": false, "note": null },
        { "key": "s4-2", "text": "Who raises its head and cries out?", "answer": "A brave frog raises its head and cries out.", "marks": 1, "source": "MP2026_ADAPTED", "sourceRef": "মোহাম্মদপুর বার্ষিক ২০২৬ · প্রশ্ন ৩", "bookRef": "Unit 10, p.97", "needsPicture": false, "note": "ব্যাকরণ ঠিক করা হয়েছে: cried → cries" },
        { "key": "s4-3", "text": "What is the moral of the story?", "answer": "What is play to one can be death to other.", "marks": 1, "source": "MP2026", "sourceRef": "মোহাম্মদপুর বার্ষিক ২০২৬ · প্রশ্ন ৩", "bookRef": "Unit 10, p.97", "needsPicture": false, "note": "মূল প্রশ্নে ২ নম্বর ছিল; এখানে ১" },
        { "key": "s4-4", "text": "What do the boys see in the pond?", "answer": "The boys see some frogs in the pond.", "marks": 1, "source": "NEW", "sourceRef": null, "bookRef": "Unit 10, p.98 (E1)", "needsPicture": false, "note": null },
        { "key": "s4-5", "text": "What does the brave frog say to the boys?", "answer": "It says, \"Stop! Stop! Look at the dead frog. What is play to you is death to us.\"", "marks": 1, "source": "NEW", "sourceRef": null, "bookRef": "Unit 10, p.99 (F6)", "needsPicture": false, "note": null },
        { "key": "s4-6", "text": "What do the boys say in reply to the frog?", "answer": "They say, \"We are just playing.\" / At last they say, \"Sorry, dear Frog. We will never do it again.\"", "marks": 1, "source": "NEW", "sourceRef": null, "bookRef": "Unit 10, p.99 (F7)", "needsPicture": false, "note": null }
      ]
